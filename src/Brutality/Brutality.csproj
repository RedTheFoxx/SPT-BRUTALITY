<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Brutality</AssemblyName>
    <RootNamespace>Brutality</RootNamespace>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Installation automatique dans BepInEx/plugins/Brutality : dotnet build -c Release -p:Install=true -->
    <Install Condition="'$(Install)' == ''">false</Install>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(SptGame)/BepInEx/core/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(SptGame)/BepInEx/core/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(SptManaged)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Comfort"><HintPath>$(SptManaged)/Comfort.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Comfort.Unity"><HintPath>$(SptManaged)/Comfort.Unity.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CommonExtensions"><HintPath>$(SptManaged)/CommonExtensions.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ItemComponent.Types"><HintPath>$(SptManaged)/ItemComponent.Types.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ItemTemplate.Types"><HintPath>$(SptManaged)/ItemTemplate.Types.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.Serialization"><HintPath>$(SptManaged)/Sirenix.Serialization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(SptManaged)/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(SptManaged)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(SptManaged)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(SptManaged)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(SptManaged)/UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="BrutalityInstall" AfterTargets="Build" Condition="'$(Install)' == 'true'">
    <MakeDir Directories="$(SptGame)/BepInEx/plugins/Brutality" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptGame)/BepInEx/plugins/Brutality" />
    <Message Importance="high" Text="Brutality installé dans $(SptGame)/BepInEx/plugins/Brutality" />
  </Target>
</Project>
