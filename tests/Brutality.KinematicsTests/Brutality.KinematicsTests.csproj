<Project Sdk="Microsoft.NET.Sdk">
  <!-- Off-game anatomical conventions test bench: compiles the plugin's math sources
       against a minimal reimplementation of Vector3/Quaternion/Mathf (same formulas as Unity). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Brutality/Core/BMath.cs" />
    <Compile Include="../../src/Brutality/Core/JointKinematics.cs" />
    <Compile Include="../../src/Brutality/Anatomy/AnatomyData.cs" />
  </ItemGroup>
</Project>
