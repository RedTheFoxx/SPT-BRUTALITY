<Project Sdk="Microsoft.NET.Sdk">
  <!-- Delirium formal proof suite: compiles the REAL Euphoria/Delirium plugin sources directly
       against an off-game 3D articulated physics simulator (floor, walls, crates, raycasts, forces, torques). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Brutality/Core/BMath.cs" />
    <Compile Include="../../src/Brutality/Core/JointKinematics.cs" />
    <Compile Include="../../src/Brutality/Anatomy/AnatomyData.cs" />
    <Compile Include="../../src/Brutality/Neural/Motor.cs" />
    <Compile Include="../../src/Brutality/Core/VarietyDirector.cs" />
    <Compile Include="../../src/Brutality/Euphoria/NmParams.cs" />
    <Compile Include="../../src/Brutality/Euphoria/NmCharacter.cs" />
    <Compile Include="../../src/Brutality/Euphoria/NmCore.cs" />
    <Compile Include="../../src/Brutality/Euphoria/Delirium/DlCharacter.cs" />
    <Compile Include="../../src/Brutality/Euphoria/Delirium/DlBalance.cs" />
    <Compile Include="../../src/Brutality/Euphoria/Delirium/DlShot.cs" />
    <Compile Include="../../src/Brutality/Euphoria/Delirium/DlBehaviours.cs" />
    <Compile Include="../../src/Brutality/Euphoria/Delirium/DlGrab.cs" />
    <Compile Include="../../src/Brutality/Euphoria/NmPerformance.cs" />
  </ItemGroup>
</Project>
